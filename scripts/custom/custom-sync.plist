<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily upstream sync and rebuild, at 4:30 or the next wake after it.
     Install: scripts/custom/install-sync.sh
     Remove:  launchctl bootout gui/$(id -u)/dev.yab.custom-sync; rm ~/Library/LaunchAgents/dev.yab.custom-sync.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.yab.custom-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/custom/sync-upstream.sh</string>
    <string>--build</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>YAB_SYNC_NOTIFY</key><string>1</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>__REPO__/build/sync.log</string>
  <key>StandardErrorPath</key><string>__REPO__/build/sync.log</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
</dict>
</plist>
