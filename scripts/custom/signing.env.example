# Copy to ~/.config/yab-dev/signing.env (kept out of the repository) once
# Apple has granted your team the web browser entitlement
# (com.apple.developer.web-browser.public-key-credential) and you made a
# macOS provisioning profile with it. scripts/custom/build-dev.sh reads it.
#
# Your signing certificate, by its SHA-1 (security find-identity -v -p codesigning):
YAB_SIGN_IDENTITY=0000000000000000000000000000000000000000
# The App ID the profile was made for; it must end in .dev:
YAB_DEV_BUNDLE_ID=io.github.you.koan.dev
# The downloaded profile:
YAB_PROVISION_PROFILE=$HOME/.config/yab-dev/koan.provisionprofile
